# Gemini API Key — get yours at https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Flask secret key — change to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Database URL — leave unset for local SQLite (recommended for local dev)
# Uncomment and set only if using a remote Postgres database:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
